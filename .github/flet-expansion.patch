+        run: |
+          $env:PATH = "$env:UCRT64_BIN;$env:PATH"
+          $rotor = Get-ChildItem build-flet -Recurse -Filter '*drmrotor*.dll' | Select-Object -First 1
+          $bearing = Get-ChildItem build-flet -Recurse -Filter '*drmbearings*.dll' | Select-Object -First 1
+          if (-not $rotor -or -not $bearing) { throw 'Native libraries missing' }
+          $env:DRMROTOR_LIB = $rotor.FullName
+          $env:DRMBEARINGS_LIB = $bearing.FullName
+          $env:DRMROTOR_DLL_DIRS = $env:UCRT64_BIN
+          $env:DRMBEARINGS_DLL_DIRS = $env:UCRT64_BIN
+          $env:PYTHONPATH = "$PWD\python\src;$PWD"
+          python -m drm_flet --check
+          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+          $out = python -m pytest python/tests python/tests_flet -q --junitxml=validation/reports/flet/pytest.xml
+          $code = $LASTEXITCODE
+          $out | Tee-Object -FilePath validation/reports/flet/pytest.txt
+          if ($code -ne 0) { exit $code }
+          if ($out -match '[1-9][0-9]* skipped') { throw 'Native tests must not be skipped' }
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: flet-windows-source-${{ github.event.pull_request.head.sha || github.sha }}
+          path: validation/reports/flet
+          if-no-files-found: error
+          retention-days: 30
