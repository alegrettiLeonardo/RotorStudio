+          git diff --exit-code fcdac252974aeeded6961dbe3310677e234a6495 HEAD -- fortran python/src/drm_core python/src/drm_studio python/tests python/tests_ui
+          git rev-parse HEAD > validation/reports/flet/source_head.txt
+          echo "UCRT64_BIN=$(cygpath -w /ucrt64/bin)" >> "$GITHUB_ENV"
+          cmake -S fortran -B build-flet -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_Fortran_COMPILER=/ucrt64/bin/gfortran.exe -DCMAKE_PREFIX_PATH=/ucrt64 -DBLA_VENDOR=OpenBLAS
+          cmake --build build-flet --parallel 2
