+      - 'python/pyproject.toml'
+      - 'scripts/flet_*.py'
+      - '.github/workflows/flet-ui-qualification.yml'
+  workflow_dispatch:
+permissions:
+  contents: read
+concurrency:
+  group: flet-source-${{ github.ref }}
+  cancel-in-progress: true
+jobs:
+  linux:
+    name: Linux - native desktop and Core integration
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    env:
+      PYTHONPATH: ${{ github.workspace }}/python/src:${{ github.workspace }}
+      DRMROTOR_LIB: ${{ github.workspace }}/build-flet/libdrmrotor.so
+      DRMBEARINGS_LIB: ${{ github.workspace }}/build-flet/libdrmbearings.so
+      OPENBLAS_NUM_THREADS: "1"
+      OMP_NUM_THREADS: "1"
+      MPLBACKEND: Agg
+      LIBGL_ALWAYS_SOFTWARE: "1"
+      GALLIUM_DRIVER: llvmpipe
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ github.event.pull_request.head.sha || github.sha }}
+          fetch-depth: 0
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - name: Install native dependencies
+        run: |
+          sudo apt-get update -qq
+          sudo apt-get install -y gfortran cmake libblas-dev liblapack-dev libgtk-3-0 libsecret-1-0 libgles2 libegl1 libgl1 libgl1-mesa-dri openbox xvfb xauth zenity
+          python -m pip install -e './python[flet,test]'
+      - name: Numerical and Qt source preservation
+        run: |
+          mkdir -p validation/reports/flet
+          git diff --exit-code fcdac252974aeeded6961dbe3310677e234a6495 HEAD -- fortran python/src/drm_core python/src/drm_studio python/tests python/tests_ui
+          git rev-parse HEAD > validation/reports/flet/source_head.txt
+      - name: Build unchanged Fortran and run CTest
+        run: |
+          set -o pipefail
+          cmake -S fortran -B build-flet -DCMAKE_BUILD_TYPE=Release
+          cmake --build build-flet -j2
+          ctest --test-dir build-flet --output-on-failure | tee validation/reports/flet/ctest.txt
+      - name: Existing Core regression and Flet adapters
+        run: |
+          set -o pipefail
+          python -m pytest python/tests python/tests_flet -q --junitxml=validation/reports/flet/pytest.xml | tee validation/reports/flet/pytest.txt
+          if grep -Eqi '[1-9][0-9]* skipped' validation/reports/flet/pytest.txt; then exit 1; fi
+          python -m drm_flet --check
+      - name: Inventory every current Qt screen and native contract
+        run: python scripts/flet_screen_inventory.py --out validation/reports/flet/screen_inventory.json
+      - name: Real Flutter desktop screenshots and handler integration
+        run: |
+          set -o pipefail
+          xvfb-run -a -s '-screen 0 1920x1200x24' bash -c 'openbox > validation/reports/flet/openbox.log 2>&1 & wm=$!; trap "kill $wm 2>/dev/null || true" EXIT; sleep 1; timeout 180s python scripts/flet_desktop_smoke.py --outdir validation/reports/flet/desktop' | tee validation/reports/flet/desktop.log
+      - name: Every implemented screen in one actual desktop session
+        run: |
+          set -o pipefail
+          xvfb-run -a -s '-screen 0 1800x1120x24' bash -c 'openbox > validation/reports/flet/openbox-all.log 2>&1 & wm=$!; trap "kill $wm 2>/dev/null || true" EXIT; sleep 1; timeout 600s python scripts/flet_all_screens_smoke.py --outdir validation/reports/flet/all_screens' | tee validation/reports/flet/all_screens.log
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: flet-linux-source-${{ github.event.pull_request.head.sha || github.sha }}
+          path: validation/reports/flet
+          if-no-files-found: error
+          retention-days: 30
+  windows:
+    name: Windows - Core and Python handlers (no desktop/frozen claim)
+    runs-on: windows-2025
+    timeout-minutes: 30
+    env:
+      OPENBLAS_NUM_THREADS: "1"
+      OMP_NUM_THREADS: "1"
+      MPLBACKEND: Agg
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ github.event.pull_request.head.sha || github.sha }}
+          fetch-depth: 0
+      - uses: msys2/setup-msys2@v2
+        with:
+          msystem: UCRT64
+          update: true
+          install: >-
+            git
+            mingw-w64-ucrt-x86_64-gcc-fortran
+            mingw-w64-ucrt-x86_64-cmake
+            mingw-w64-ucrt-x86_64-ninja
+            mingw-w64-ucrt-x86_64-openblas
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
