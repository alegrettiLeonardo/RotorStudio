+    assert set(a)==set(b)
+    for key in a:
+        if a[key].dtype.kind in 'US':np.testing.assert_array_equal(a[key],b[key],err_msg=key)
+        else:np.testing.assert_allclose(a[key],b[key],rtol=1e-11,atol=1e-12,err_msg=key,equal_nan=True)
